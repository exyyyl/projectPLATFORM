# PostgreSQL
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=uploads
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# App
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173
NGINX_PORT=80
CORS_ORIGIN=http://localhost,http://app.localhost,http://dashboard.localhost
VITE_API_URL=/api

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

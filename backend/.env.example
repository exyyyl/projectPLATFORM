DATABASE_URL="postgresql://platform:platform@localhost:5432/platform?schema=public"
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost

# JWT (спринт 1.4)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# alias для совместимости (не используйте оба набора одновременно)
# JWT_SECRET / JWT_EXPIRES_IN — устаревшие имена

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_PRESIGNED_TTL_SEC=300

# JWT
JWT_SECRET=change-me-to-a-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

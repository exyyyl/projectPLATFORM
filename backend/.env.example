DATABASE_URL="postgresql://platform:platform@localhost:5432/platform?schema=public"
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost,http://app.localhost,http://dashboard.localhost

# JWT (спринт 1.4)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# alias для совместимости (не используйте оба набора одновременно)
# JWT_SECRET / JWT_EXPIRES_IN — устаревшие имена

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_PRESIGNED_TTL_SEC=300
UPLOAD_HARD_MAX_FILE_SIZE_BYTES=26214400
UPLOAD_HARD_MAX_TOTAL_SIZE_BYTES=104857600
UPLOAD_HARD_MAX_FILES=5
